{
  "project": "MindToosa",
  "version": "1.0.0",
  "framework": { "name": "next", "major": 16, "notes": "Use proxy.ts instead of middleware.ts" },
  "rules": [
    {
      "id": "next-proxy-only",
      "type": "hard",
      "description": "Use proxy.ts instead of middleware.ts",
      "forbid": ["middleware.ts", "middleware.js", "middleware.tsx", "middleware.jsx"],
      "recommend": ["proxy.ts"]
    },
    {
      "id": "zod-validate",
      "type": "hard",
      "description": "Validate all external input with Zod",
      "require": ["zod"]
    },
    {
      "id": "no-eslint",
      "type": "soft",
      "description": "Project intentionally does not use ESLint (see SECURITY.md for rationale)"
    }
  ],
  "sensitive_paths": [
    "src/server/services/**",
    "src/server/env.ts",
    "auth.ts",
    "proxy.ts",
    "supabase/migrations/**"
  ],
  "preflight_checks": [
    "no-middleware-files",
    "zod-present-for-new-routes",
    "confirm-sensitive-human-review"
  ],
  "package_policy": {
    "mode": "recommend-updates",
    "auto_pr": true,
    "allow_auto_merge": false
  },
  "recommendations": [".vscode/extensions.json", ".devcontainer/devcontainer.json"],
  "metadata": { "createdBy": "copilot", "date": "2026-02-21" }
}
